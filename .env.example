# Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration (Defaults to local SQLite)
DATABASE_URL=sqlite+aiosqlite:///./niftydebate.db

# OpenAlgo / Paper Trading Configuration
OPENALGO_API_KEY=your_openalgo_api_key_here
OPENALGO_HOST=http://127.0.0.1:5000

# DhanHQ API Configuration (Optional - fallback to public NSE real market feed if not provided)
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_access_token
DHAN_BASE_URL=https://api.dhan.co/v2

# System Flags
FORCE_ANALYZER_MODE=true
